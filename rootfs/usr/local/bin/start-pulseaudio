#!/usr/bin/env bash
set -euo pipefail

export HOME=/tmp/pulse-home
export XDG_CONFIG_HOME=/tmp/pulse-home/.config
export XDG_RUNTIME_DIR=/tmp/runtime-root

rm -f /tmp/pulse/native
mkdir -p /tmp/pulse "$HOME" "$XDG_CONFIG_HOME" "$XDG_RUNTIME_DIR"
chmod 700 "$HOME" "$XDG_RUNTIME_DIR"

exec pulseaudio \
  --daemonize=no \
  --exit-idle-time=-1 \
  --disallow-exit=true \
  --load="module-native-protocol-unix socket=/tmp/pulse/native auth-anonymous=1" \
  --load="module-null-sink sink_name=retroarch_sink sink_properties=device.description=RetroArch" \
  --load="module-null-source source_name=retroarch_source source_properties=device.description=RetroArch"
