#!/usr/bin/env bash
set -euo pipefail

mkdir -p /config/retroarch \
         /config/retroarch/autoconfig \
         /config/retroarch/system \
         /config/retroarch/saves \
         /config/retroarch/states \
         /config/.config \
         /config/logs

if [ ! -f /config/apps.json ]; then
  cp /usr/local/share/retroarch-sunshine/apps.json /config/apps.json
fi

if [ ! -f /config/sunshine.conf ]; then
  cp /usr/local/share/retroarch-sunshine/sunshine.conf /config/sunshine.conf
fi

if grep -qx 'output_name = screen' /config/sunshine.conf; then
  sed -i '/^output_name = screen$/d' /config/sunshine.conf
fi

if [ -n "${SUNSHINE_CSRF_ALLOWED_ORIGINS:-}" ]; then
  if grep -q '^csrf_allowed_origins =' /config/sunshine.conf; then
    sed -i "s|^csrf_allowed_origins =.*|csrf_allowed_origins = ${SUNSHINE_CSRF_ALLOWED_ORIGINS}|" /config/sunshine.conf
  else
    printf 'csrf_allowed_origins = %s\n' "$SUNSHINE_CSRF_ALLOWED_ORIGINS" >> /config/sunshine.conf
  fi
fi

set_sunshine_config() {
  local key="$1"
  local value="$2"

  if grep -q "^${key} =" /config/sunshine.conf; then
    sed -i "s|^${key} =.*|${key} = ${value}|" /config/sunshine.conf
  else
    printf '%s = %s\n' "$key" "$value" >> /config/sunshine.conf
  fi
}

set_retroarch_config() {
  local key="$1"
  local value="$2"

  if grep -q "^${key} =" /config/retroarch/retroarch.cfg; then
    sed -i "s|^${key} =.*|${key} = \"${value}\"|" /config/retroarch/retroarch.cfg
  else
    printf '%s = "%s"\n' "$key" "$value" >> /config/retroarch/retroarch.cfg
  fi
}

if [ -n "${SUNSHINE_ENCODER:-}" ]; then
  set_sunshine_config encoder "$SUNSHINE_ENCODER"
fi

if [ -n "${SUNSHINE_ADAPTER_NAME:-}" ]; then
  set_sunshine_config adapter_name "$SUNSHINE_ADAPTER_NAME"
fi

if [ -n "${SUNSHINE_HEVC_MODE:-}" ]; then
  set_sunshine_config hevc_mode "$SUNSHINE_HEVC_MODE"
fi

if [ -n "${SUNSHINE_CAPTURE:-}" ]; then
  set_sunshine_config capture "$SUNSHINE_CAPTURE"
elif [ "${XORG_DRIVER:-auto}" = "nvidia" ]; then
  set_sunshine_config capture nvfbc
else
  set_sunshine_config capture x11
fi

if [ ! -f /config/retroarch/retroarch.cfg ]; then
  cp /usr/local/share/retroarch-sunshine/retroarch.cfg /config/retroarch/retroarch.cfg
fi

set_retroarch_config input_driver x
set_retroarch_config input_joypad_driver udev
