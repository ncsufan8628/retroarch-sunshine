#!/usr/bin/env bash
set -euo pipefail

for _ in $(seq 1 50); do
  if [ -S /run/udev/control ]; then
    break
  fi
  sleep 0.1
done

write_input_config() {
  cat <<'EOF'
Section "InputClass"
    Identifier "libinput keyboard catchall"
    MatchIsKeyboard "on"
    Driver "libinput"
EndSection

Section "InputClass"
    Identifier "libinput pointer catchall"
    MatchIsPointer "on"
    Driver "libinput"
EndSection

Section "InputClass"
    Identifier "libinput touchpad catchall"
    MatchIsTouchpad "on"
    Driver "libinput"
EndSection
EOF
}

write_dummy_config() {
  cat > /tmp/xorg-dummy.conf <<EOF
Section "ServerFlags"
    Option "AutoAddDevices" "true"
    Option "AllowMouseOpenFail" "true"
    Option "DontVTSwitch" "true"
EndSection

Section "Device"
    Identifier "DummyDevice"
    Driver "dummy"
    VideoRam 256000
EndSection

Section "Monitor"
    Identifier "DummyMonitor"
    HorizSync 5.0-1000.0
    VertRefresh 5.0-200.0
EndSection

Section "Screen"
    Identifier "DummyScreen"
    Device "DummyDevice"
    Monitor "DummyMonitor"
    DefaultDepth ${SCREEN_DEPTH}
    SubSection "Display"
        Depth ${SCREEN_DEPTH}
        Modes "${SCREEN_WIDTH}x${SCREEN_HEIGHT}"
        Virtual ${SCREEN_WIDTH} ${SCREEN_HEIGHT}
    EndSubSection
EndSection

$(write_input_config)
EOF
}

write_nvidia_config() {
  local bus_id_section=""
  local nvidia_module_path
  nvidia_module_path="$(nvidia_xorg_module_path || true)"
  if [ -z "$nvidia_module_path" ]; then
    echo "NVIDIA Xorg driver nvidia_drv.so was not found in the container" >&2
    exit 1
  fi

  if [ -n "${NVIDIA_XORG_BUS_ID:-}" ]; then
    bus_id_section="    BusID \"${NVIDIA_XORG_BUS_ID}\""
  fi

  cat > /tmp/xorg-nvidia.conf <<EOF
Section "ServerFlags"
    Option "AutoAddDevices" "true"
    Option "AllowMouseOpenFail" "true"
    Option "DontVTSwitch" "true"
EndSection

Section "ServerLayout"
    Identifier "NvidiaLayout"
    Screen 0 "NvidiaScreen" 0 0
EndSection

Section "Files"
    ModulePath "${nvidia_module_path}"
    ModulePath "/usr/lib/xorg/modules"
EndSection

Section "Device"
    Identifier "NvidiaDevice"
    Driver "nvidia"
${bus_id_section}
    Option "AllowEmptyInitialConfiguration" "true"
    Option "HardDPMS" "false"
    Option "ModeDebug" "true"
EndSection

Section "Monitor"
    Identifier "NvidiaMonitor"
    HorizSync 5.0-1000.0
    VertRefresh 5.0-200.0
EndSection

Section "Screen"
    Identifier "NvidiaScreen"
    Device "NvidiaDevice"
    Monitor "NvidiaMonitor"
    DefaultDepth ${SCREEN_DEPTH}
    Option "AllowEmptyInitialConfiguration" "true"
    Option "MetaModes" "${SCREEN_WIDTH}x${SCREEN_HEIGHT}"
    Option "ModeValidation" "NoDFPNativeResolutionCheck, NoMaxPClkCheck, NoHorizSyncCheck, NoVertRefreshCheck, NoEdidModes"
    SubSection "Display"
        Depth ${SCREEN_DEPTH}
        Modes "${SCREEN_WIDTH}x${SCREEN_HEIGHT}"
        Virtual ${SCREEN_WIDTH} ${SCREEN_HEIGHT}
    EndSubSection
EndSection

$(write_input_config)
EOF
}

write_modeset_config() {
  local bus_id_section=""
  if [ -n "${XORG_BUS_ID:-}" ]; then
    bus_id_section="    BusID \"${XORG_BUS_ID}\""
  fi

  cat > /tmp/xorg-modeset.conf <<EOF
Section "ServerFlags"
    Option "AutoAddDevices" "true"
    Option "AllowMouseOpenFail" "true"
    Option "DontVTSwitch" "true"
EndSection

Section "ServerLayout"
    Identifier "ModesetLayout"
    Screen 0 "ModesetScreen" 0 0
EndSection

Section "Device"
    Identifier "ModesetDevice"
    Driver "modesetting"
${bus_id_section}
    Option "AccelMethod" "glamor"
    Option "DRI" "3"
EndSection

Section "Monitor"
    Identifier "ModesetMonitor"
    HorizSync 5.0-1000.0
    VertRefresh 5.0-200.0
EndSection

Section "Screen"
    Identifier "ModesetScreen"
    Device "ModesetDevice"
    Monitor "ModesetMonitor"
    DefaultDepth ${SCREEN_DEPTH}
    SubSection "Display"
        Depth ${SCREEN_DEPTH}
        Modes "${SCREEN_WIDTH}x${SCREEN_HEIGHT}"
        Virtual ${SCREEN_WIDTH} ${SCREEN_HEIGHT}
    EndSubSection
EndSection

$(write_input_config)
EOF
}

exec_xorg() {
  local config="$1"
  exec Xorg "$DISPLAY" \
    -config "$config" \
    -logfile /config/logs/xorg.log \
    -noreset \
    -nolisten tcp \
    +extension GLX \
    +extension RANDR \
    +extension RENDER
}

start_xorg() {
  local config="$1"
  Xorg "$DISPLAY" \
    -config "$config" \
    -logfile /config/logs/xorg.log \
    -noreset \
    -nolisten tcp \
    +extension GLX \
    +extension RANDR \
    +extension RENDER
}

has_nvidia_xorg_driver() {
  [ -n "$(nvidia_xorg_module_path || true)" ]
}

nvidia_xorg_module_path() {
  local driver
  driver="$(
    for root in /usr /run/nvidia/driver; do
      [ -e "$root" ] || continue
      find "$root" -name nvidia_drv.so -print -quit 2>/dev/null
    done | head -n1
  )"
  if [ -n "$driver" ]; then
    local driver_dir
    local module_dir
    driver_dir="$(dirname "$driver")"
    module_dir="$(dirname "$driver_dir")"
    if [ "$(basename "$driver_dir")" = "drivers" ]; then
      printf '%s\n' "$module_dir"
    else
      printf '%s\n' "$driver_dir"
    fi
  fi
}

case "${XORG_DRIVER:-auto}" in
  nvidia)
    write_nvidia_config
    exec_xorg /tmp/xorg-nvidia.conf
    ;;
  modeset)
    write_modeset_config
    exec_xorg /tmp/xorg-modeset.conf
    ;;
  dummy)
    write_dummy_config
    exec_xorg /tmp/xorg-dummy.conf
    ;;
  auto)
    if has_nvidia_xorg_driver; then
      echo "NVIDIA Xorg driver found; starting GPU-backed headless Xorg"
      write_nvidia_config
      if start_xorg /tmp/xorg-nvidia.conf; then
        exit 0
      fi
      echo "NVIDIA Xorg failed; falling back to dummy Xorg" >&2
    else
      echo "NVIDIA Xorg driver not found; starting dummy Xorg"
    fi
    write_dummy_config
    exec_xorg /tmp/xorg-dummy.conf
    ;;
  *)
    echo "Unsupported XORG_DRIVER=${XORG_DRIVER}. Use auto, nvidia, or dummy." >&2
    exit 1
    ;;
esac
