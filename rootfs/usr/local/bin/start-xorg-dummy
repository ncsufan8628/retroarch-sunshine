#!/usr/bin/env bash
set -euo pipefail

for _ in $(seq 1 50); do
  if [ -S /run/udev/control ]; then
    break
  fi
  sleep 0.1
done

write_input_config() {
  cat <<'EOF'
Section "InputClass"
    Identifier "libinput keyboard catchall"
    MatchIsKeyboard "on"
    Driver "libinput"
EndSection

Section "InputClass"
    Identifier "libinput pointer catchall"
    MatchIsPointer "on"
    Driver "libinput"
EndSection

Section "InputClass"
    Identifier "libinput touchpad catchall"
    MatchIsTouchpad "on"
    Driver "libinput"
EndSection
EOF
}

write_dummy_config() {
  cat > /tmp/xorg-dummy.conf <<EOF
Section "ServerFlags"
    Option "AutoAddDevices" "true"
    Option "AllowMouseOpenFail" "true"
    Option "DontVTSwitch" "true"
EndSection

Section "Device"
    Identifier "DummyDevice"
    Driver "dummy"
    VideoRam 256000
EndSection

Section "Monitor"
    Identifier "DummyMonitor"
    HorizSync 5.0-1000.0
    VertRefresh 5.0-200.0
EndSection

Section "Screen"
    Identifier "DummyScreen"
    Device "DummyDevice"
    Monitor "DummyMonitor"
    DefaultDepth ${SCREEN_DEPTH}
    SubSection "Display"
        Depth ${SCREEN_DEPTH}
        Modes "${SCREEN_WIDTH}x${SCREEN_HEIGHT}"
        Virtual ${SCREEN_WIDTH} ${SCREEN_HEIGHT}
    EndSubSection
EndSection

$(write_input_config)
EOF
}

write_nvidia_config() {
  local bus_id_section=""
  local nvidia_driver_path
  local nvidia_module_path
  local nvidia_bus_id
  nvidia_driver_path="$(nvidia_xorg_driver_path || true)"
  nvidia_module_path="$(nvidia_xorg_module_path "$nvidia_driver_path")"
  if [ -z "$nvidia_module_path" ]; then
    echo "NVIDIA Xorg driver nvidia_drv.so was not found in the container" >&2
    log_nvidia_xorg_candidates >&2
    exit 1
  fi

  if [ -n "${NVIDIA_XORG_BUS_ID:-}" ]; then
    nvidia_bus_id="$NVIDIA_XORG_BUS_ID"
  else
    nvidia_bus_id="$(nvidia_xorg_bus_id || true)"
  fi

  if [ -n "$nvidia_bus_id" ]; then
    bus_id_section="    BusID \"${nvidia_bus_id}\""
  fi

  cat > /tmp/xorg-nvidia.conf <<EOF
Section "ServerFlags"
    Option "AutoAddDevices" "true"
    Option "AllowMouseOpenFail" "true"
    Option "DontVTSwitch" "true"
EndSection

Section "ServerLayout"
    Identifier "NvidiaLayout"
    Screen 0 "NvidiaScreen" 0 0
EndSection

Section "Files"
    ModulePath "${nvidia_module_path}"
    ModulePath "/usr/lib/xorg/modules"
EndSection

Section "Device"
    Identifier "NvidiaDevice"
    Driver "nvidia"
${bus_id_section}
    Option "AllowEmptyInitialConfiguration" "true"
    Option "UseDisplayDevice" "None"
    Option "HardDPMS" "false"
    Option "ModeDebug" "true"
    Option "VirtualHeads" "1"
EndSection

Section "Monitor"
    Identifier "NvidiaMonitor"
    HorizSync 5.0-1000.0
    VertRefresh 5.0-200.0
EndSection

Section "Screen"
    Identifier "NvidiaScreen"
    Device "NvidiaDevice"
    Monitor "NvidiaMonitor"
    DefaultDepth ${SCREEN_DEPTH}
    Option "AllowEmptyInitialConfiguration" "true"
    Option "MetaModes" "${SCREEN_WIDTH}x${SCREEN_HEIGHT}"
    Option "ModeValidation" "NoDFPNativeResolutionCheck, NoMaxPClkCheck, NoHorizSyncCheck, NoVertRefreshCheck, NoEdidModes"
    SubSection "Display"
        Depth ${SCREEN_DEPTH}
        Modes "${SCREEN_WIDTH}x${SCREEN_HEIGHT}"
        Virtual ${SCREEN_WIDTH} ${SCREEN_HEIGHT}
    EndSubSection
EndSection

$(write_input_config)
EOF

  cp /tmp/xorg-nvidia.conf /config/logs/xorg-nvidia.conf
  echo "Using NVIDIA Xorg driver ${nvidia_driver_path}" >&2
  echo "Using NVIDIA Xorg module path ${nvidia_module_path}" >&2
  if [ -n "$nvidia_bus_id" ]; then
    echo "Using NVIDIA Xorg BusID ${nvidia_bus_id}" >&2
  fi
}

write_modeset_config() {
  local bus_id_section=""
  if [ -n "${XORG_BUS_ID:-}" ]; then
    bus_id_section="    BusID \"${XORG_BUS_ID}\""
  fi

  cat > /tmp/xorg-modeset.conf <<EOF
Section "ServerFlags"
    Option "AutoAddDevices" "true"
    Option "AllowMouseOpenFail" "true"
    Option "DontVTSwitch" "true"
EndSection

Section "ServerLayout"
    Identifier "ModesetLayout"
    Screen 0 "ModesetScreen" 0 0
EndSection

Section "Device"
    Identifier "ModesetDevice"
    Driver "modesetting"
${bus_id_section}
    Option "AccelMethod" "glamor"
    Option "DRI" "3"
EndSection

Section "Monitor"
    Identifier "ModesetMonitor"
    HorizSync 5.0-1000.0
    VertRefresh 5.0-200.0
EndSection

Section "Screen"
    Identifier "ModesetScreen"
    Device "ModesetDevice"
    Monitor "ModesetMonitor"
    DefaultDepth ${SCREEN_DEPTH}
    SubSection "Display"
        Depth ${SCREEN_DEPTH}
        Modes "${SCREEN_WIDTH}x${SCREEN_HEIGHT}"
        Virtual ${SCREEN_WIDTH} ${SCREEN_HEIGHT}
    EndSubSection
EndSection

$(write_input_config)
EOF
}

exec_xorg() {
  local config="$1"
  cleanup_xorg_lock "$DISPLAY"
  exec Xorg "$DISPLAY" \
    -config "$config" \
    -logfile /config/logs/xorg.log \
    -noreset \
    -nolisten tcp \
    +extension GLX \
    +extension RANDR \
    +extension RENDER
}

start_xorg() {
  local config="$1"
  cleanup_xorg_lock "$DISPLAY"
  Xorg "$DISPLAY" \
    -config "$config" \
    -logfile /config/logs/xorg.log \
    -noreset \
    -nolisten tcp \
    +extension GLX \
    +extension RANDR \
    +extension RENDER
}

start_xorg_on_display() {
  local display="$1"
  local config="$2"
  local logfile="$3"
  cleanup_xorg_lock "$display"
  Xorg "$display" \
    -config "$config" \
    -logfile "$logfile" \
    -noreset \
    -nolisten tcp \
    +extension GLX \
    +extension RANDR \
    +extension RENDER
}

has_nvidia_xorg_driver() {
  [ -n "$(nvidia_xorg_driver_path || true)" ]
}

nvidia_xorg_driver_path() {
  local driver
  driver="$(
    for root in /usr /run/nvidia/driver; do
      [ -e "$root" ] || continue
      find "$root" -name nvidia_drv.so -print -quit 2>/dev/null
    done | head -n1
  )"
  if [ -n "$driver" ]; then
    printf '%s\n' "$driver"
  fi
}

nvidia_xorg_module_path() {
  local driver="$1"
  if [ -n "$driver" ]; then
    local driver_dir
    local module_dir
    driver_dir="$(dirname "$driver")"
    module_dir="$(dirname "$driver_dir")"
    if [ "$(basename "$driver_dir")" = "drivers" ]; then
      printf '%s\n' "$module_dir"
    else
      printf '%s\n' "$driver_dir"
    fi
  fi
}

log_nvidia_xorg_candidates() {
  echo "Searched these roots for nvidia_drv.so:"
  for root in /usr /run/nvidia/driver; do
    if [ -e "$root" ]; then
      echo "  present: $root"
      find "$root" -name nvidia_drv.so -print 2>/dev/null | sed 's/^/    /'
    else
      echo "  missing: $root"
    fi
  done
}

cleanup_xorg_lock() {
  local display="${1:-$DISPLAY}"
  local display_number="${display#:}"
  display_number="${display_number%%.*}"
  local lock_file="/tmp/.X${display_number}-lock"
  local socket_file="/tmp/.X11-unix/X${display_number}"

  if [ -f "$lock_file" ]; then
    local lock_pid
    lock_pid="$(tr -d ' ' < "$lock_file" 2>/dev/null || true)"
    if [ -n "$lock_pid" ] && kill -0 "$lock_pid" 2>/dev/null; then
      echo "Xorg display ${display} is already owned by pid ${lock_pid}" >&2
      return 0
    fi
    echo "Removing stale Xorg lock ${lock_file}" >&2
    rm -f "$lock_file" "$socket_file"
  fi
}

run_virtualgl_xorg() {
  local gpu_display="${VGL_DISPLAY:-:0}"
  local capture_display="${CAPTURE_DISPLAY:-:1}"
  write_nvidia_config
  write_dummy_config

  start_xorg_on_display "$gpu_display" /tmp/xorg-nvidia.conf /config/logs/xorg-gpu.log &
  local gpu_pid="$!"

  for _ in $(seq 1 100); do
    if xdpyinfo -display "$gpu_display" >/dev/null 2>&1; then
      break
    fi
    if ! kill -0 "$gpu_pid" 2>/dev/null; then
      wait "$gpu_pid"
    fi
    sleep 0.1
  done

  start_xorg_on_display "$capture_display" /tmp/xorg-dummy.conf /config/logs/xorg.log &
  local capture_pid="$!"

  trap 'kill "$gpu_pid" "$capture_pid" 2>/dev/null || true; wait "$gpu_pid" "$capture_pid" 2>/dev/null || true' TERM INT EXIT
  wait -n "$gpu_pid" "$capture_pid"
}

nvidia_xorg_bus_id() {
  if ! command -v nvidia-smi >/dev/null 2>&1; then
    return 0
  fi

  local pci
  pci="$(nvidia-smi --query-gpu=pci.bus_id --format=csv,noheader 2>/dev/null | head -n1 || true)"
  if [ -z "$pci" ]; then
    return 0
  fi

  pci="${pci#*:}"
  pci="${pci%.*}"
  local bus="${pci%%:*}"
  local slot_func="${pci#*:}"
  local slot="${slot_func%%:*}"
  local func="${slot_func#*:}"
  printf 'PCI:%d:%d:%d\n' "0x$bus" "0x$slot" "0x$func"
}

case "${XORG_DRIVER:-auto}" in
  nvidia)
    write_nvidia_config
    exec_xorg /tmp/xorg-nvidia.conf
    ;;
  virtualgl)
    run_virtualgl_xorg
    ;;
  modeset)
    write_modeset_config
    exec_xorg /tmp/xorg-modeset.conf
    ;;
  dummy)
    write_dummy_config
    exec_xorg /tmp/xorg-dummy.conf
    ;;
  auto)
    if has_nvidia_xorg_driver; then
      echo "NVIDIA Xorg driver found; starting GPU-backed headless Xorg"
      write_nvidia_config
      if start_xorg /tmp/xorg-nvidia.conf; then
        exit 0
      fi
      echo "NVIDIA Xorg failed; falling back to dummy Xorg" >&2
    else
      echo "NVIDIA Xorg driver not found; starting dummy Xorg"
    fi
    write_dummy_config
    exec_xorg /tmp/xorg-dummy.conf
    ;;
  *)
    echo "Unsupported XORG_DRIVER=${XORG_DRIVER}. Use auto, nvidia, or dummy." >&2
    exit 1
    ;;
esac
