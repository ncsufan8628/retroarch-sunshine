#!/usr/bin/env bash
set -euo pipefail

export DISPLAY="${DISPLAY:-:0}"
export PULSE_SERVER="${PULSE_SERVER:-unix:/tmp/pulse/native}"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp/runtime-root}"

retroarch_cmd=(retroarch --config /config/retroarch/retroarch.cfg --menu --fullscreen)
if [ "${XORG_DRIVER:-auto}" = "virtualgl" ] && command -v vglrun >/dev/null 2>&1; then
  retroarch_cmd=(vglrun -d "${VGL_DISPLAY:-:0}" "${retroarch_cmd[@]}")
fi

"${retroarch_cmd[@]}" &
retroarch_pid="$!"

for _ in $(seq 1 100); do
  window_id="$(xdotool search --onlyvisible --class retroarch 2>/dev/null | head -n1 || true)"
  if [ -n "$window_id" ]; then
    xdotool windowactivate "$window_id" 2>/dev/null || true
    xdotool windowfocus "$window_id" 2>/dev/null || true
    break
  fi
  sleep 0.1
done

wait "$retroarch_pid"
